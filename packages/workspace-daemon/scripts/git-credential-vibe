#!/usr/bin/env node
// git credential helper for Agentforge workspaces. Installed as /opt/wsd/git-credential-vibe and
// configured via `git config --system credential.helper /opt/wsd/git-credential-vibe`.
// Asks the workspace daemon (wsd) over its local unix socket; tokens are kept in wsd's memory only.
// Only the "get" operation is answered; "store"/"erase" are ignored.
import http from 'node:http';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const op = process.argv[2];
if (op !== 'get') process.exit(0);

const uid = typeof process.getuid === 'function' ? process.getuid() : 0;
const candidates = [process.env.WSD_CRED_SOCKET, '/run/wsd/cred.sock', path.join(os.tmpdir(), `vibe-wsd-${uid}`, 'cred.sock')].filter(Boolean);
const socketPath = candidates.find((p) => {
  try {
    return fs.statSync(p).isSocket();
  } catch {
    return false;
  }
});
if (!socketPath) process.exit(0);

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => (input += c));
process.stdin.on('end', () => {
  const req = http.request({ socketPath, path: '/credential', method: 'POST', timeout: 5000 }, (res) => {
    let out = '';
    res.setEncoding('utf8');
    res.on('data', (c) => (out += c));
    res.on('end', () => {
      if (res.statusCode === 200 && out) process.stdout.write(out);
      process.exit(0);
    });
  });
  req.on('timeout', () => req.destroy());
  req.on('error', () => process.exit(0));
  req.end(input);
});

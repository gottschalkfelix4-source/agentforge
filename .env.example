# Master key for encrypting stored secrets (API keys, GitHub token). Generate with:
#   openssl rand -hex 32
AGENTFORGE_SECRET_KEY=

# Host path that is mounted as /data into the app container (needed for workspace bind mounts).
HOST_DATA_PATH=

# Images (published by .github/workflows/images.yml; replace gottschalkfelix4-source with your GitHub user/org).
AGENTFORGE_IMAGE=ghcr.io/gottschalkfelix4-source/agentforge:latest
WORKSPACE_IMAGE=ghcr.io/gottschalkfelix4-source/agentforge-workspace:latest
# For local builds instead:
# WORKSPACE_IMAGE=agentforge-workspace:dev

# Optional
# GITHUB_CLIENT_ID=          # OAuth App with device flow enabled
# WORKSPACE_IDLE_MINUTES=0   # auto-stop idle workspaces (0 = off)
# PREVIEW_HOST=preview.example.com  # behind a reverse proxy: one extra hostname for all previews (→ PREVIEW_MODE=host)
# PREVIEW_MODE=port          # or "subdomain" with PREVIEW_DOMAIN=preview.example.com
# AGENTFORGE_SECURE_COOKIES=1  # session cookie always "Secure" (set when Agentforge is only reached via HTTPS)
# Whose X-Forwarded-For/-Proto to believe (client IP for the login rate limit, https detection).
# Default: nobody on the host; loopback + the container's own docker networks in the container.
# Values: false | true (every hop, only if your proxy overwrites these headers) | hop count, e.g. 1 |
# comma list of IPs/CIDRs or loopback, linklocal, uniquelocal, e.g. 192.168.1.10,172.16.0.0/12
# AGENTFORGE_TRUST_PROXY=

# Unraid defaults: nobody:users
PUID=99
PGID=100
TZ=Europe/Berlin
